<Window x:Class="OpenGameSave.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OpenGameSave" Width="1180" Height="780" Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"><Grid Margin="34"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="OpenGameSave" Foreground="{StaticResource Accent}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Never lose a save again." FontSize="29" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="Versioned local snapshots for the games you care about." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><TextBlock Text="LOCAL ONLY  ·  NO ACCOUNTS" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11"/></Grid><Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="15" Margin="0,26,0,18"><StackPanel Orientation="Horizontal"><Button Content="Choose save folder" Click="ChooseSave_Click"/><Button Content="Choose backup library" Click="ChooseLibrary_Click"/><Button x:Name="SnapshotButton" Content="Create snapshot" Click="Snapshot_Click" Background="{StaticResource Accent}" Foreground="White"/><TextBlock x:Name="ProfileText" Text="No game profile configured" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel></Border><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><Grid><TextBlock Text="Save history" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="CountText" Text="No snapshots yet" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></Grid><ListBox x:Name="SnapshotList" Margin="0,12,0,0" Background="White" BorderBrush="{StaticResource Line}" SelectionChanged="Snapshot_SelectionChanged"/></StackPanel><Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="20"><StackPanel><TextBlock Text="SELECTED SNAPSHOT" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="SelectedText" Text="Nothing selected" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,16"/><TextBlock x:Name="StatusText" Text="Choose a save folder to begin." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/><Button Content="Restore selected snapshot" Click="Restore_Click" HorizontalAlignment="Left" Margin="0,20,0,0"/><Separator Margin="0,22,0,16"/><TextBlock Text="SAFE BY DEFAULT" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Every snapshot is hashed. Restores refuse to overwrite existing files." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></Border></Grid><TextBlock Grid.Row="3" Text="OpenGameSave 0.1.0  ·  MIT licensed" Foreground="{StaticResource Muted}" Margin="0,20,0,0"/></Grid></Window>
