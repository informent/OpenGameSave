<Window x:Class="OpenGameSave.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OpenGameSave" Width="1220" Height="820" MinWidth="1000" MinHeight="680" Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <Grid Margin="34,28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><StackPanel><TextBlock Text="OPENGAMESAVE" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="Bold"/><TextBlock Text="Protect the saves that matter." FontSize="30" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Local snapshots with verification before every restore." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><Border HorizontalAlignment="Right" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="13,8"><StackPanel><TextBlock Text="LOCAL LIBRARY" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock Text="No account required" Foreground="{StaticResource Text}" FontSize="12" Margin="0,3,0,0"/></StackPanel></Border></Grid>
        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,26,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="1  CHOOSE A GAME" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="Detect Steam games" Click="DetectSteam_Click"/><ComboBox x:Name="GameSelector" Width="220" Margin="8,0,0,0" DisplayMemberPath="Name"/><Button Content="Find save folders" Click="LocateSave_Click"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Margin="28,0,0,0"><TextBlock Text="ACTIVE PROFILE" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><TextBlock x:Name="ProfileText" Text="No game selected" Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="  Select a detected game above, or choose a folder manually." Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel></StackPanel></Grid></Border>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="0.92*"/></Grid.ColumnDefinitions><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,0,14,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="SAVE HISTORY" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock Text="Versioned snapshots" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><TextBlock x:Name="CountText" Text="No snapshots yet" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom"/></Grid><ListBox Grid.Row="1" x:Name="SnapshotList" Margin="0,17,0,0" Background="Transparent" BorderThickness="0" SelectionChanged="Snapshot_SelectionChanged"/></Grid></Border><Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="22"><StackPanel><TextBlock Text="SNAPSHOT DETAILS" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="SelectedText" Text="Nothing selected" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,12"/><TextBlock x:Name="StatusText" Text="Choose a game to begin." TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="21"/><Button Content="Restore selected snapshot" Click="Restore_Click" HorizontalAlignment="Left" Margin="0,20,0,0" Background="{StaticResource Accent}" Foreground="White"/><Separator Margin="0,24,0,18"/><TextBlock Text="SAFE BY DEFAULT" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Snapshots are hashed before restore. Existing files are never silently overwritten." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/><StackPanel Orientation="Horizontal" Margin="0,24,0,0"><Button Content="Choose save folder" Click="ChooseSave_Click"/><Button Content="Choose backup library" Click="ChooseLibrary_Click"/></StackPanel><Button x:Name="SnapshotButton" Content="Create snapshot" Click="Snapshot_Click" Margin="0,10,0,0"/></StackPanel></Border></Grid>
        <TextBlock Grid.Row="3" Text="OpenGameSave 0.4.0  ·  MIT licensed  ·  Your files stay on your computer" Foreground="{StaticResource Muted}" Margin="0,18,0,0"/>
    </Grid>
</Window>
